# Razorpay Credentials
# Get these from your Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Public Key for Client-side (prefixed with VITE_)
VITE_RAZORPAY_KEY_ID=

# Google AdSense Configuration (Disabled by default; set only after receiving a real AdSense account)
# Example format for VITE_ADSENSE_CLIENT_ID: ca-pub-XXXXXXXXXXXXXXXX (16 digits)
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_DEFAULT_SLOT_ID=
VITE_ENABLE_ADS=false
